# SpaceXAI / xAI — niemals in die Flutter-App oder APK legen.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Optional: gemeinsames App-Token. Wenn gesetzt, muss die App denselben Wert senden.
TECHDECK_API_TOKEN=

# Limit: KI-Anfragen pro IP und Minute
RATE_LIMIT_PER_MINUTE=30

HOST=0.0.0.0
PORT=8787
